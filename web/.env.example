# Elyrion web environment. Copy to .env.local. Never commit real secrets; no private keys belong here.
NEXT_PUBLIC_IDENTITY=
NEXT_PUBLIC_POOL=
# Treasury address used by the admin page gate. The pledge reads pool.treasury() on-chain.
NEXT_PUBLIC_TREASURY=
# REQUIRED: block the contracts were deployed at. The indexer refuses to run ("not configured") while 0/unset.
NEXT_PUBLIC_DEPLOY_BLOCK=0
NEXT_PUBLIC_RPC_URL=https://rpc.elysium.kinetiq.xyz
# Optional: public repository URL shown in the Docs MCP install steps (https:// only)
NEXT_PUBLIC_SOURCE_URL=
# NEXT_PUBLIC_* values are built into the site: on Vercel, redeploy after changing any of them.
# House agent wallet: an agent gets the house badge only when this wallet registered it AND still owns it
HOUSE_AGENT_OWNER=
